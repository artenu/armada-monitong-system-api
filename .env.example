# Salin menjadi .env lalu isi nilainya. File .env TIDAK boleh di-commit.

# === Server ===
NODE_ENV=development
PORT=8000
# Zona waktu bisnis untuk "hari ini" & tampilan waktu
APP_TIMEZONE=Asia/Makassar
# Origin frontend yang diizinkan (pisahkan dengan koma). Kosongkan bila frontend lewat proxy/Nginx yang sama.
CORS_ORIGINS=http://localhost:5173

# === Database ===
# Development dengan Docker (npm run db:up): password container PostgreSQL
POSTGRES_PASSWORD=GANTI_PASSWORD
# Pakai 127.0.0.1 (bukan localhost) agar Prisma tidak mencoba IPv6 di Windows
DATABASE_URL="postgresql://armada:GANTI_PASSWORD@127.0.0.1:5433/armada_dev?schema=public"

# === Auth ===
# Minimal 32 karakter. Buat dengan: openssl rand -base64 48
JWT_ACCESS_SECRET=GANTI_DENGAN_SECRET_ACAK_MINIMAL_32_KARAKTER
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# true di production (wajib HTTPS). false hanya untuk development via http://
COOKIE_SECURE=false

# === Upload berkas ===
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=25

# === Seed (opsional) ===
# Password awal akun seed. Kosong = dibuat acak dan dicetak sekali saat `npm run db:seed`.
# SEED_PASSWORD_ADMIN=
# SEED_PASSWORD_SALES=
# SEED_PASSWORD_OPERASIONAL=
# SEED_PASSWORD_SALES_OPS=
# SEED_PASSWORD_FINANCE=

# Backup (npm run db:backup). Sebaiknya folder di disk/lokasi LAIN dari database,
# mis. D:\Backup\armada atau folder OneDrive/NAS kantor.
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30
# Folder pg_dump.exe bila tidak terdeteksi otomatis (Windows: C:\Program Files\PostgreSQL\18\bin)
# PG_BIN_DIR=
